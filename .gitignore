.vscode/settings.json

# Test-run artifacts. Untracked-but-not-ignored files at the repo root are treated as
# an off-lane edit by the XYZ relay containment guard, so a builder that merely RUNS
# the test suite in its isolated worktree fails its turn (exit 6) for doing exactly
# what its brief required. Cost two marathon phases on 2026-07-28 before diagnosis.
.pytest_cache/
.coverage
.coverage.*

# Scratch/test databases — never commit these. Also: an untracked test.db in the
# working tree trips marathon containment, which reads git porcelain and cannot
# tell a builder's scratch file from an off-lane escape (GH-250, vb5).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ...except the release ledger. `releases.sql` is the git-mergeable dump and is
# authoritative at merge boundaries, but it CANNOT stand alone: `releases check
# --rebuild` refuses with `rule=not-initialized` when no releases.db is present,
# so a dump-only commit leaves a fresh clone with no ledger and no way to
# rebuild one. Both artifacts are tracked, which is what the upstream repo does.
# This is a single named file, not a relaxation of the rule above.
!releases.db

# Regenerable side-by-side output of the release ledger (`releases gen`), and its
# drift report. Both are derived from releases.db; upstream ignores them too.
RELEASES.generated.md
RELEASES.generated.md.drift

# AI agent scratch workspaces — never repo content (GH-266)
.gemini/

# Operator-supplied Google OAuth client (never commit the real one; the
# *.example.json template is committed deliberately and stays tracked).
google_oauth_client.json
client_secret*.json

# --- GH-291 consolidation: private runtime content carried over from the
# retiring Hypercart-Dev-Tools/rebalance-OS folder. These live in the working
# tree on the operator's machine and must never reach this public remote.
# Audited 2026-08-17 with `git check-ignore` against the runbook's carry-over
# list; only the entries that were genuinely missing are added here.
MEMORY.md
phases/
DIAGRAM.md

# Relay/marathon transcripts are agent working logs, never repo content (#33).
# They stay on disk for the operator; they do not belong in public history —
# committing them is what put 433MB of transcripts in this tree in the first place.
relay-system/
/.tick/

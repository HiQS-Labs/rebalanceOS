<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rebalance-os.daily-work-synthesis</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{REBALANCE_DIR}}/utils/job_guard.py</string>
        <string>--name</string><string>scheduler-daily-work-synthesis</string>
        <string>--max-runtime-seconds</string><string>180</string>
        <string>--lifecycle-job</string><string>daily-work-synthesis</string>
        <string>--</string>
        <string>{{REBALANCE_DIR}}/scripts/daily_work_synthesis.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/daily-work-synthesis.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/daily-work-synthesis.log</string>
</dict>
</plist>

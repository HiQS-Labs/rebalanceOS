<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rebalance-os.daily-synthesis</string>

    <!-- Run through a /bin/bash wrapper, NOT python3 directly: a directly-launched
         interpreter is denied access to ~/Documents (TCC), but the bash wrapper
         inherits the existing Full Disk Access grant used by the other rebalance
         jobs — so no new Full Disk Access entry is needed. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{REBALANCE_DIR}}/utils/daily_synthesis.sh</string>
    </array>

    <!-- Fire at 18:20 every day. If the Mac is asleep at 18:20, launchd runs the
         job as soon as it next wakes — the script's own late-run guard skips any
         catch-up that fires after midnight (past the 00:00 rollover).
         GH-74: replaces the separately-scheduled obsidian-daily-sync (18:20) and
         git-pulse-daily-synthesis (18:30) — both wrote to the same vault file,
         and the second job existed only to fire after the first so its block
         landed below. One process now does both syntheses in order, so there is
         no second fire time to keep in sync. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>

    <!-- Stay false: loading should not fire an off-schedule summary write. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Log lives OUTSIDE ~/Documents: that folder is TCC-protected and launchd
         can't open files there without Full Disk Access. ~/Library/Logs is fine. -->
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/daily-synthesis.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/rebalance-os/daily-synthesis.log</string>
</dict>
</plist>
